# Holo Black — btop.
#
# Box outlines are slate, so the data is the only thing that glows: lavender for
# structure and throughput, magenta for load and temperature climbing, ice for
# the cool side of every gradient. Mint is absent on purpose — a monitor is a
# measurement, not a success state.

theme[main_bg]="#0A0F1E"
theme[main_fg]="#DCDDF7"
theme[title]="#B8B8FF"
theme[hi_fg]="#B8B8FF"

theme[selected_bg]="#2A2F45"
theme[selected_fg]="#E6E7FF"
theme[inactive_fg]="#9095CE"
theme[graph_text]="#C4C6E8"

theme[meter_bg]="#2A2F45"
theme[proc_misc]="#C4C6E8"

theme[cpu_box]="#2A2F45"
theme[mem_box]="#2A2F45"
theme[net_box]="#2A2F45"
theme[proc_box]="#2A2F45"
theme[div_line]="#2A2F45"

theme[temp_start]="#7CE7FF"
theme[temp_mid]="#F5D9A8"
theme[temp_end]="#FF6E9E"

theme[cpu_start]="#B8B8FF"
theme[cpu_mid]="#C7A8FF"
theme[cpu_end]="#FF4FD8"

theme[free_start]="#7CE7FF"
theme[free_mid]="#B8B8FF"
theme[free_end]="#C7A8FF"

theme[cached_start]="#B8B8FF"
theme[cached_mid]="#7CE7FF"
theme[cached_end]="#C7A8FF"

theme[available_start]="#F5D9A8"
theme[available_mid]="#FF9ABF"
theme[available_end]="#FF6E9E"

theme[used_start]="#7CE7FF"
theme[used_mid]="#B8B8FF"
theme[used_end]="#C7A8FF"

theme[download_start]="#F5D9A8"
theme[download_mid]="#FF9ABF"
theme[download_end]="#FF6E9E"

theme[upload_start]="#7CE7FF"
theme[upload_mid]="#B8B8FF"
theme[upload_end]="#C7A8FF"

theme[process_start]="#B8B8FF"
theme[process_mid]="#C7A8FF"
theme[process_end]="#FF4FD8"

theme[gradient_color_0]="#0A0F1E"
theme[gradient_color_1]="#151B30"
theme[gradient_color_2]="#2A2F45"
theme[gradient_color_3]="#9095CE"
theme[gradient_color_4]="#5F668C"
theme[gradient_color_5]="#DCDDF7"
theme[gradient_color_6]="#C4C6E8"
theme[gradient_color_7]="#F4F4FF"
